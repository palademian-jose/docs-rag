# ---- Provider selection -------------------------------------------------
# fake | openrouter | anthropic | openai
# Leave empty for auto: openrouter when OPENROUTER_API_KEY is set, else
# anthropic/openai when their key is set, else fake (with a one-line warning).
LLM_PROVIDER=
# Model ids are OpenRouter slugs; the anthropic/openai direct backends strip the
# vendor prefix automatically.
LLM_MODEL=anthropic/claude-sonnet-4.5
JUDGE_MODEL=openai/gpt-4.1-mini
CHEAP_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers sent to OpenRouter (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=docs-rag
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- Embeddings -----------------------------------------------------------
# fake | openai (needs OPENAI_API_KEY) | local (uv sync --extra local)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=256

# ---- Vector store ---------------------------------------------------------
# memory | pgvector (uv sync --extra pg, docker compose --profile pg up)
VECTOR_STORE=memory
INDEX_PATH=data/index/index.npz
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# ---- Retrieval ------------------------------------------------------------
CORPUS_PATH=data/corpus
# Word tokens (about 0.75 LLM tokens). See reports/chunk_sweep.md before changing.
CHUNK_SIZE=128
CHUNK_OVERLAP=16
# dense | hybrid
RETRIEVAL_MODE=hybrid
CANDIDATES_PER_RETRIEVER=50
RRF_K=60
# fake | cohere | local | none
RERANKER=fake
RERANK_TOP_K=5
# Minimum top reranker score below which the pipeline refuses to answer.
REFUSAL_THRESHOLD=0.15

# ---- Cache / cost / limits ------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Near-duplicate layer on top of the exact cache (llmops.cache.SemanticCache); off by default.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.92
# Optional: redis://localhost:6379/0 (uv sync --extra redis)
REDIS_URL=
DAILY_COST_CAP_USD=5.0
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# ---- Tracing --------------------------------------------------------------
TRACE_PATH=traces/spans.jsonl
# Prices come from llm-evalops (llmops/pricing.json). Optional override file:
PRICING_PATH=
