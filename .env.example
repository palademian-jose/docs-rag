# ---- Provider selection -------------------------------------------------
# fake | anthropic | openai   (defaults to fake when no key is present)
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-4-5
JUDGE_MODEL=gpt-4o
CHEAP_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- Embeddings -----------------------------------------------------------
# fake | openai | local
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=256

# ---- Vector store ---------------------------------------------------------
# memory | pgvector
VECTOR_STORE=memory
INDEX_PATH=data/index/index.npz
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# ---- Retrieval ------------------------------------------------------------
CORPUS_PATH=data/corpus
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# dense | hybrid
RETRIEVAL_MODE=hybrid
CANDIDATES_PER_RETRIEVER=50
RRF_K=60
# fake | cohere | local | none
RERANKER=fake
RERANK_TOP_K=5
# Minimum reranker score below which the pipeline refuses to answer.
REFUSAL_THRESHOLD=0.15

# ---- Cache / cost / limits ------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_URL=
DAILY_COST_CAP_USD=5.0
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# ---- Tracing --------------------------------------------------------------
TRACE_PATH=traces/spans.jsonl
PRICING_PATH=pricing.json
